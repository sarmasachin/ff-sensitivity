{
  "name": "api",
  "version": "0.0.1",
  "description": "FF Sensitivity Ops API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "e2e:community": "ts-node --transpile-only scripts/e2e-community.ts",
    "e2e:claims": "ts-node --transpile-only scripts/e2e-claims.ts",
    "e2e:challenge": "ts-node --transpile-only scripts/e2e-challenge.ts",
    "e2e:scratch": "ts-node --transpile-only scripts/e2e-scratch.ts",
    "e2e:names": "ts-node --transpile-only scripts/e2e-names.ts",
    "e2e:support": "ts-node --transpile-only scripts/e2e-support.ts",
    "e2e:promos": "ts-node --transpile-only scripts/e2e-promos.ts",
    "e2e:profile": "ts-node --transpile-only scripts/e2e-profile.ts",
    "e2e:push": "ts-node --transpile-only scripts/e2e-push.ts",
    "e2e:app": "ts-node --transpile-only scripts/e2e-app.ts",
    "e2e:app:extra": "ts-node --transpile-only scripts/e2e-app-extra.ts",
    "e2e:devices": "ts-node --transpile-only scripts/e2e-devices.ts",
    "e2e:devices:extra": "ts-node --transpile-only scripts/e2e-devices-extra.ts",
    "e2e:wallets": "ts-node --transpile-only scripts/e2e-wallets.ts",
    "e2e:wallets:extra": "ts-node --transpile-only scripts/e2e-wallets-extra.ts",
    "e2e:users": "ts-node --transpile-only scripts/e2e-users.ts",
    "e2e:users:extra": "ts-node --transpile-only scripts/e2e-users-extra.ts",
    "e2e:copy": "ts-node --transpile-only scripts/e2e-copy.ts",
    "e2e:copy:extra": "ts-node --transpile-only scripts/e2e-copy-extra.ts",
    "e2e:staff": "ts-node --transpile-only scripts/e2e-staff.ts",
    "e2e:staff:extra": "ts-node --transpile-only scripts/e2e-staff-extra.ts",
    "e2e:audit": "ts-node --transpile-only scripts/e2e-audit.ts",
    "e2e:audit:extra": "ts-node --transpile-only scripts/e2e-audit-extra.ts",
    "e2e:settings": "ts-node --transpile-only scripts/e2e-settings.ts",
    "e2e:settings:extra": "ts-node --transpile-only scripts/e2e-settings-extra.ts",
    "e2e:overview": "ts-node --transpile-only scripts/e2e-overview.ts",
    "e2e:overview:extra": "ts-node --transpile-only scripts/e2e-overview-extra.ts",
    "e2e:analytics": "ts-node --transpile-only scripts/e2e-analytics.ts",
    "db:up": "echo Use local PostgreSQL on 5432 — Docker is not used in this project",
    "db:down": "echo Use local PostgreSQL on 5432 — Docker is not used in this project"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "firebase-admin": "^13.0.2",
    "google-auth-library": "^9.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
