# Copy to .env and adjust if needed.
DATABASE_URL="postgresql://ffops:ffops_dev_password@localhost:5432/ff_sensitivity_ops?schema=public"
JWT_ACCESS_SECRET="dev-access-secret-change-me-min-32-chars!!"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-min-32-chars!"
JWT_ACCESS_TTL="7d"
JWT_REFRESH_TTL_DAYS="14"
PORT=4000
# Local: http://localhost:3002
# Production (isolated admin host): https://app.sensitivitysettings.com
CORS_ORIGIN="http://localhost:3002"
SUPERADMIN_EMAIL="sharma.sachinctr@gmail.com"
SUPERADMIN_PASSWORD="change-this-strong-password"

# Admin login email OTP (Hostinger Mail)
ADMIN_OTP_ENABLED="false"
ADMIN_OTP_SECRET="change-me-to-a-random-64-character-secret"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="no-reply@sensitivitysettings.com"
SMTP_PASSWORD="hostinger-mailbox-password"
SMTP_FROM_EMAIL="no-reply@sensitivitysettings.com"
SMTP_FROM_NAME="FF Sensitivity Ops"

GOOGLE_WEB_CLIENT_ID="your-web-oauth-client-id.apps.googleusercontent.com"
JWT_USER_SECRET="dev-user-jwt-secret-change-me-min-32-chars!!"
JWT_USER_TTL="7d"

# Firebase Admin (FCM send) — path relative to api/ or absolute
FIREBASE_ADMIN_PATH="secrets/firebase-admin.json"

